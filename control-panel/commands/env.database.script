$database = dirname(dirname(dirname(__FILE__))).DIRECTORY_SEPARATOR."database".DIRECTORY_SEPARATOR."enviroment.vm"; 

// Start the CLI interaction loop
while (true) {
    echo "\nEnviroment Cell Name: ";
    // Read user input from the console
    $line = trim(fgets(STDIN));
    // Split the input into command and arguments
    $parts = explode(' ', $line, 2); // Split only on the first space to get command and rest of the line
    $cell_name = strtolower($parts[0]);
    $args = $parts[1] ?? ''; // Get the rest of the line as arguments

    echo "\nCell Data [".$cell_name."] : ";
    // Read user input from the console
    $line = trim(fgets(STDIN));
    // Split the input into command and arguments
    $parts = explode(' ', $line, 2); // Split only on the first space to get command and rest of the line
    $description = strtolower($parts[0]);
    $args = $parts[1] ?? ''; // Get the rest of the line as arguments   

     
