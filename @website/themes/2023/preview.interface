}

.account .payment-cards-grid .payment-card .card-header .card-badges span {
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 500;
}

.account .payment-cards-grid .payment-card .card-header .card-badges .default-badge {
