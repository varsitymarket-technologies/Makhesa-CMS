<main>
  <div class="bg-black py-vh-3">
    <div class="container bg-black px-vw-5 py-vh-3 rounded-5 shadow">
      <div style="padding-top:20vh !important;" class="p-5 pt-0 mt-5 aos-init aos-animate" data-aos="fade">
        <span class="h5 text-secondary fw-lighter">One of our web assistance will be assigned to your website.</span>
        <h2 class="display-4"> Get A Website </h2>
      </div>
    </div>
  </div>

    <style>
        .form-container { max-width: 600px; margin: 0 auto; padding: 30px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .tab { display: none; } /* Hide all steps by default */
        input, textarea { width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        button:hover { opacity: 0.9; }

        /* Step Navigation and Progress Bar */
        #step-indicator { text-align: center; margin-bottom: 30px; }
        .step { height: 15px; width: 15px; margin: 0 2px; background-color: #bbbbbb; border: none; border-radius: 50%; display: inline-block; opacity: 0.5; }
        .step.active { opacity: 1; background-color: #4CAF50; }
        .step.finish { background-color: #04AA6D; }

        .btn-group { overflow: auto; }
        .btn-group button { float: right; }
        #prevBtn { background-color: #ccc; color: black; float: left; }
    </style>

<div class="form-container">
    
    <form id="regForm">
        <div class="tab">
            <h3>Lets Get To Know Your Business</h3>
            <label for="businessName">Business Name:</label>
            <input type="text" id="businessName" name="businessName" placeholder="Enter business name..." required>
            
            <label for="businessDesc">Business Description:</label>
            <textarea id="businessDesc" name="businessDesc" rows="5" placeholder="Describe the business, its industry, and services..." required></textarea>
        </div>

        <div class="tab">
            <h3>Tell us more about your website</h3>
            <label for="websiteURL">Website Domain:</label>
            <input type="url" id="websiteURL" name="websiteURL" placeholder="www.example.com">
            
            <label for="websiteGoals">Website Primary Goal:</label>
            <input type="text" id="websiteGoals" name="websiteGoals" placeholder="e.g., Generate leads, Sell products, Provide information">
        </div>

        <div class="tab">
            <h3>Contact Details</h3>
            <label for="whatsappNumber">Phone Number:</label>
            <input type="tel" id="whatsappNumber" name="whatsappNumber" placeholder="+1234567890 (Include country code)" required>
            
            <label for="contactName">Primary Contact Name:</label>
            <input type="text" id="contactName" name="contactName" placeholder="Contact Person's Name">
        </div>

        <div id="step-indicator">
            <span class="step"></span>
            <span class="step"></span>
            <span class="step"></span>
        </div>

        <div class="btn-group">
            <button class="btn btn-outline-light" type="button" id="prevBtn" onclick="nextPrev(-1)">Previous</button>
            <button class="btn btn-outline-light" type="button" id="nextBtn" onclick="nextPrev(1)">Next</button>
        </div>

    </form>
</div>

<script>
    var currentTab = 0; // Current tab is set to be the first tab (0)
    showTab(currentTab); // Display the current tab

    function showTab(n) {
        // This function will display the specified tab of the form...
        var x = document.getElementsByClassName("tab");
        x[n].style.display = "block";
        
        //... and fix the Previous/Next buttons:
        if (n == 0) {
            document.getElementById("prevBtn").style.display = "none";
        } else {
            document.getElementById("prevBtn").style.display = "inline";
        }
        if (n == (x.length - 1)) {
            document.getElementById("nextBtn").innerHTML = "Submit";
        } else {
            document.getElementById("nextBtn").innerHTML = "Next";
        }
        
        //... and run a function that displays the correct step indicator:
        fixStepIndicator(n)
    }

    function nextPrev(n) {
        // This function will figure out which tab to display
        var x = document.getElementsByClassName("tab");
        
        // Exit the function if any field in the current tab is invalid:
        if (n == 1 && !validateForm()) return false;
        
        // Hide the current tab:
        x[currentTab].style.display = "none";
        
        // Increase or decrease the current tab by 1:
        currentTab = currentTab + n;
        
        // if you have reached the end of the form...
        if (currentTab >= x.length) {
            // ... the form gets submitted (or, in this case, we prepare the WhatsApp link).
            generateWhatsAppLink();
            document.getElementById("regForm").style.display = "none"; // Hide the form
            return false;
        }
        
        // Otherwise, display the correct tab:
        showTab(currentTab);
    }

    function validateForm() {
        // This function deals with validation of the form fields
        var x, y, i, valid = true;
        x = document.getElementsByClassName("tab");
        y = x[currentTab].getElementsByTagName("input");
        z = x[currentTab].getElementsByTagName("textarea");

        // A loop that checks every input field in the current tab:
        for (i = 0; i < y.length; i++) {
            // If a field is empty...
            if (y[i].hasAttribute("required") && y[i].value == "") {
                // add an "invalid" class to the field:
                y[i].className += " invalid";
                valid = false;
            }
        }
        // Check for required textareas as well
        for (i = 0; i < z.length; i++) {
            if (z[i].hasAttribute("required") && z[i].value == "") {
                z[i].className += " invalid";
                valid = false;
            }
        }

        // If the valid status is true, mark the current step as finished and valid:
        if (valid) {
            document.getElementsByClassName("step")[currentTab].className += " finish";
        }
        return valid; // return the valid status
    }

    function fixStepIndicator(n) {
        // This function removes the "active" class of all steps...
        var i, x = document.getElementsByClassName("step");
        for (i = 0; i < x.length; i++) {
            x[i].className = x[i].className.replace(" active", "");
        }
        //...and adds the "active" class to the current step:
        x[n].className += " active";
    }

    function generateWhatsAppLink() {
        // Retrieve all data from the form
        const businessName = document.getElementById("businessName").value;
        const businessDesc = document.getElementById("businessDesc").value;
        const websiteURL = document.getElementById("websiteURL").value;
        const websiteGoals = document.getElementById("websiteGoals").value;
        const whatsappNumber = document.getElementById("whatsappNumber").value.replace(/\D/g, ''); // Clean number for link
        const contactName = document.getElementById("contactName").value;

        // Construct the message text
        const message = `*Website Construction Job Request*\n\n` + 
                        `*Business Description:*\n` +
                        `Name: ${businessName}\n` +
                        `Description: ${businessDesc}\n\n` +
                        `*Website Information:*\n` +
                        `URL: ${websiteURL}\n` +
                        `Goal: ${websiteGoals}\n\n` +
                        `*Business Contact:*\n` +
                        `Contact Name: ${contactName}\n` +
                        `Number: ${whatsappNumber}`+
                        `\n\nGood day Agent i hope to get a website with the Business Startup Package, your feedback will be helpful.`;

        // URL encode the message
        const encodedMessage = encodeURIComponent(message);
        
        // Use the WhatsApp API link format: wa.me/<number>?text=<message>
        // Note: The number used here is the *destination* number where the message will be sent.
        // **YOU MUST REPLACE 'YOUR_DESTINATION_WHATSAPP_NUMBER' with the actual number you want to receive the message.**
        const destinationNumber = '+27682167383'; // <--- CHANGE THIS!

        const whatsappLink = `https://wa.me/${destinationNumber}?text=${encodedMessage}`;

        // Display a submission success message with the link
        const formContainer = document.querySelector('.form-container');
        formContainer.innerHTML = '<h3>Agent Ready </h3>' +
                                  '<p>Click the button below to start the site developement.</p>' +
                                  `<a href="${whatsappLink}" target="_blank" style="display: block; text-align: center; margin-top: 20px;">` +
                                  '<button class="btn btn-outline-light">Relay To Agent</button></a>' +
                                  '<p style="margin-top: 20px;">*An agent will soon contact you regarding your website development.*</p>';
    }
</script>

</main>