if (!defined("PAGE_INDEX")){
    define("PAGE_INDEX","1");
}


# Create Header Functions 
function __HEADER__($input){
    if (!defined("__DATABASE_ENGINE__")){
        trigger_error("Database Module Missing");
        die(0);
    }  

    $page_url = ex(PAGE_INDEX);
    $sql = "SELECT * FROM `tblcanvas` WHERE (`url` = '{$page_url}')";
    $result = __DATABASE_ENGINE__->query($sql);
    if (is_array($result)){
        if (!empty($result)){        
            $e = $result[0][$input] ?? null;
            echo($e);

            #return $e;         
        }
    }

}

function use_style($source){
    if (!defined('__ACTIVE_THEME__')){
        return null;
    }
    $theme_folder = dirname(dirname(__FILE__)).DIRECTORY_SEPARATOR."themes".DIRECTORY_SEPARATOR.__ACTIVE_THEME__.DIRECTORY_SEPARATOR;
    $e = file_get_contents($theme_folder.$source);
    echo PHP_EOL."<style>".PHP_EOL.$e.PHP_EOL."</style>";
}

function use_card($source){
    if (!defined('__ACTIVE_THEME__')){
        return null;
    }
    $theme_folder = dirname(dirname(__FILE__)).DIRECTORY_SEPARATOR."themes".DIRECTORY_SEPARATOR.__ACTIVE_THEME__.DIRECTORY_SEPARATOR;
    $card_data = $theme_folder.($source).".card";
    if (file_exists($card_data)){
        @include_once $card_data;
    }
}

function construct_page(){
    if (!defined("__DATABASE_ENGINE__")){
        trigger_error("Database Module Missing");
        die(0);
    }

    if (!defined('__DEBUG_PREVIEW__')){
        $page_url = ex(PAGE_INDEX);
        $sql = "SELECT * FROM `tblcanvas` WHERE (`url` = '{$page_url}')";
    }else{
        $page_url = ex(PAGE_INDEX);
        $sql = "SELECT * FROM `tblcanvas` WHERE (`id` = '{$page_url}')";
        
        $theme_folder = dirname(dirname(__FILE__)).DIRECTORY_SEPARATOR."themes".DIRECTORY_SEPARATOR.__ACTIVE_THEME__.DIRECTORY_SEPARATOR;
        $preview_file = $theme_folder."init/pages/".$page_url; 

        if (file_exists($preview_file)){
            @include_once $preview_file; 
            return ; 
        }
    }


    $result = __DATABASE_ENGINE__->query($sql);
    if (is_array($result)){
        if (!empty($result)){        
            $e = $result[0]['id'];
            $source_page = hash("sha256",$e).".page";
            $pwd = dirname(__FILE__).DIRECTORY_SEPARATOR."pages".DIRECTORY_SEPARATOR.$source_page;
            @include_once $pwd;
            return ;       
        }
    }
    
    if (!defined('__ACTIVE_THEME__')){
        return null;
    }
    $theme_folder = dirname(dirname(__FILE__)).DIRECTORY_SEPARATOR."themes".DIRECTORY_SEPARATOR.__ACTIVE_THEME__.DIRECTORY_SEPARATOR;
    $lost_file = $theme_folder."pages/404"; 

    @include_once $lost_file; 
    return;  
}

function use_script($source){
    if (!defined('__ACTIVE_THEME__')){
        return null;
    }
    $theme_folder = dirname(dirname(__FILE__)).DIRECTORY_SEPARATOR."themes".DIRECTORY_SEPARATOR.__ACTIVE_THEME__.DIRECTORY_SEPARATOR;
    $e = file_get_contents($theme_folder.$source);
    echo PHP_EOL."<script>".PHP_EOL.$e.PHP_EOL."</script>";
}


function load_module($name)
{
    $library_folder = dirname( dirname(__FILE__) ).DIRECTORY_SEPARATOR."library".DIRECTORY_SEPARATOR.$name.DIRECTORY_SEPARATOR;

    # Search For .json Local File 
    $initiate_dependency = $library_folder.".json"; 
    if (!file_exists($initiate_dependency)){
        trigger_error("Failed To Find Initiation File: .json --".$name); 
    }

    # Initiate The Library
    $initiate_file = $library_folder."initiate.php";
    @include_once $initiate_file ?? trigger_error("Failed To Find Initiation File: initiate.php --".$name) ; 
    $initiate_env = json_decode(file_get_contents($initiate_dependency),true); 
    $module = new $initiate_env['class'];
    return $module; 
}

function use_template($template,$search,$replace){
    $template_file = dirname(dirname(__FILE__)).DIRECTORY_SEPARATOR."themes".DIRECTORY_SEPARATOR.__ACTIVE_THEME__.DIRECTORY_SEPARATOR."templates".DIRECTORY_SEPARATOR.$template.".guide"; 
    if (file_exists($template_file)){
        $template_data = file_get_contents($template_file); 
        $data = str_ireplace($search, $replace, $template_data); 
        return $data; 
    }
    return null; 
}


function _web_media_($url){
     $media_hash = explode('/@media/',$url)[1];
     $db = __DATABASE__;
     $sql = "SELECT * FROM gallery WHERE (`hash` = '{$media_hash}') LIMIT 1";
     $image_data = $db->query($sql)[0];
    $currentImage = $image_data['image_path'] ?? '404.jpg';
    $curr_path = dirname(dirname(dirname(__FILE__))) . DIRECTORY_SEPARATOR."@media".DIRECTORY_SEPARATOR;
    $imagePath = $curr_path . $currentImage;

    // Check if the file actually exists and is readable
    if (file_exists($imagePath) && is_readable($imagePath)) {

        // Determine the MIME type based on the file extension
        $extension = pathinfo($currentImage, PATHINFO_EXTENSION);
        #$mimeType = 'application/octet-stream'; // Default generic type

        $mimeType = 'image/jpg';
        
        switch (strtolower($extension)) {
            case 'jpg':
                $mimeType = 'image/jpg';
                break;
            case 'jpeg':
                $mimeType = 'image/jpeg';
                break;
            case 'png':
                $mimeType = 'image/png';
                break;
            case 'gif':
                $mimeType = 'image/gif';
                break;
            case 'webp':
                $mimeType = 'image/webp';
                break;
                // Add more image types if needed
        }

        // Read the file content
        $imageData = file_get_contents($imagePath);
        // Encode the binary data to Base64
        $base64Image = base64_encode($imageData);
        $dataUri = "data:$mimeType;base64,$base64Image";
        #$dataUri = '/@media/'.$currentImage;
        return $dataUri;
    } 
} 




?>