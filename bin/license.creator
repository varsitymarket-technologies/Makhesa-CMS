@include_once "license.library";
final class license_creator extends license_library
{   
    private $fingerprint;

    public function fingerprint_lock($lock){
        $this->fingerprint['fingerprint_lock'] = $lock;
    }
    public function algorithm($algorithm){
        $this->fingerprint['algorithm'] = $algorithm;
    }

    public function __construct($username,$password,$domain,$ip){
    $fingerprint = [
        'algorithm' => 'silk_encryption',
        'fingerprint_lock' => '__ACCESS_CODE__',
        'authentication' => [
            'username' => $username,
            'password' => $password,
            'domain' => $domain,
            'ip' => $ip,
            'server' => $ip,
        ]
    ];
    $this->fingerprint = $fingerprint;

    }

    public function export($file=dirname(dirname(__FILE__)).DIRECTORY_SEPARATOR."license.key"){
        $e = $this->create_print($this->fingerprint);
        $ei = $this->format_to_fingerprint($e,"\n");
        $ex = file_put_contents($file,$ei);
        return $ex;
    }
}

