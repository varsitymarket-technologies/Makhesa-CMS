@include_once "license.library";
final class license_innit extends license_library
{
    public $license_key;
    public function __construct()
    {
        $this->license_key = dirname(dirname(__FILE__)) . "\license-key";
    }

    function import($file)
    {
        $this->license_key = $file;
    }

    function capture()
    {
        $contents = file_get_contents($this->license_key);
        $e = $this->format_to_print($contents, "\n");
        $i = $this->understand_print($e);
        return $i;
    }
}

