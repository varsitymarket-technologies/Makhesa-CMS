<script>
/**
 * Auto-Scroll Resume Script
 * Persists scroll position based on the specific page URL
 */

const ScrollPersistence = {
    // Unique key for storage based on the current path
    storageKey: `scroll_pos_${window.location.pathname}`,

    init() {
        // 1. Restore position when the page is ready
        window.addEventListener('load', () => {
            this.restorePosition();
        });

        // 2. Save position when the user leaves or closes the tab
        window.addEventListener('beforeunload', () => {
            this.savePosition();
        });
    },

    savePosition() {
        const scrollData = {
            x: window.scrollX,
            y: window.scrollY
        };
        localStorage.setItem(this.storageKey, JSON.stringify(scrollData));
    },

    restorePosition() {
        const savedData = localStorage.getItem(this.storageKey);
        
        if (savedData) {
            const { x, y } = JSON.parse(savedData);
            
            // Use scrollTo with 'smooth' behavior for a nicer transition, 
            // or 'auto' for an instant jump.
            window.scrollTo({
                top: y,
                left: x,
                behavior: 'smooth' 
            });
            
            console.log(`Restored position to: ${y}px`);
        }
    }
};

// Start the script
ScrollPersistence.init();

</script>


<style>
  /* 1. The Block Wrapper with Solid Border */
  .block-request-engine-container {
    position: relative; /* Essential for the floating button positioning */
    margin: 10px auto;
    
    /* Solid Border Line */
    border: 2px solid #6366f1; 
    border-radius: 8px;
    font-family: sans-serif;
  }

  /* 2. The Fixed/Floating Tool Button Container */
  .block-engine-container-toolbar {
    position: absolute;
    top: -18px; /* Offset to sit on the border line */
    right: calc(50vw - 70px); 
    z-index: 10;
  }

  /* 3. The Tool Button Style */
  .tool-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #6366f1;
    color: white;
    border: none;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    transition: all 0.2s ease;
  }

  .tool-btn:hover {
    background: #4f46e5;
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(99, 102, 241, 0.4);
  }

  /* Content Styling */
  .block-engine-container-content {
    text-align: center;
    color: #374151;
  }
  
  .block-engine-container-content h2 { margin-top: 0; }
</style>

