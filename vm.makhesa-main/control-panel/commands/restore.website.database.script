SELECT --user tracking
    user_session,
    COUNT(*) AS actions
FROM tblanalytical_view
GROUP BY user_session
ORDER BY actions DESC
LIMIT 10;


--ACTIVITY PER DAY
SELECT DATE(created_at) AS day, COUNT(*) AS total
FROM tblanalytical_view
GROUP BY day
ORDER BY day DESC;

--ACTIVITY PER MONTH
SELECT 
    YEAR(created_at) AS year,
    MONTH(created_at) AS month,
    COUNT(*) AS total
FROM tblanalytical_view
GROUP BY year, month
ORDER BY year DESC, month DESC;

--ACTIVITY PER YEAR
SELECT YEAR(created_at) AS year, COUNT(*) AS total
FROM tblanalytical_view
GROUP BY year
ORDER BY year DESC;


--BASIC SQL NEEDS TO BE LABELED AND EDITED.
--REPLACE AND UPDATE

CREATE TABLE tblanalytical_view (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tracking_session VARCHAR(100),
    user_session VARCHAR(100),
    ip_address VARCHAR(255),
    country VARCHAR(100),
    city VARCHAR(100),
    model VARCHAR(100),
    make VARCHAR(100),
    operating_system VARCHAR(100),
    browser VARCHAR(100),
    page_title TEXT,
    page_link TEXT,
    activity_type VARCHAR(50) DEFAULT 'page_view',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,

    INDEX (created_at),
    INDEX (user_session)
);

